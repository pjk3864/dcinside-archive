    "parent_id": "268527994",
    "author": "ㅇㅇ",
    "published": "11.25 17:44:51",
    "depth": 1,
    "body": "탄압받거나 거부됨",
    "body_html": "탄압받거나 거부됨",
    "deleted": false
  },
