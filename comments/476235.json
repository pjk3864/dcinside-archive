    "parent_id": "267371536",
    "author": "ㅇㅇ",
    "published": "11.06 14:03:21",
    "depth": 1,
    "body": "남자나 여자나 취급 똑같다 ㅅㄱ",
    "body_html": "남자나 여자나 취급 똑같다 ㅅㄱ",
    "deleted": false
